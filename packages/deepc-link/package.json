{
  "name": "deepc-link",
  "version": "0.0.4",
  "type": "module",
  "description": "deepc-link — deepc 多端互联隧道插件",
  "main": "dist/index.js",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/deepc-link-client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "pack:tgz": "node scripts/pack.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "release": "npm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "http-proxy": "^1.18.1"
  }
}
