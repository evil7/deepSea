{
  "name": "deepc-link",
  "version": "0.0.1",
  "type": "module",
  "description": "deepc-link — deepc 本地插件 + 远程 RTC 通信中间件（操作互联 + 工程同步）",
  "main": "dist/index.js",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/deepc-link-client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "pack": "pnpm build && pnpm pack",
    "prepublishOnly": "node scripts/build.mjs",
    "release": "pnpm publish"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.13.3",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "node-datachannel": "0.33.0"
  }
}
