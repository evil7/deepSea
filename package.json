{
  "name": "deepsea",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @deepsea/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "format": "oxfmt --write \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "preview": "pnpm --filter @deepsea/web preview"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "~6"
  }
}
